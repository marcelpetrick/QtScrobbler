# Instrument maintained production targets, keeping test code out of mutation scope.
option(QTSCROBBLER_COVERAGE "Collect LLVM source line and branch coverage" OFF)
set(QTSCROBBLER_MULL_PLUGIN "" CACHE FILEPATH "Matching Clang Mull IR plugin")
option(QTSCROBBLER_SANITIZERS "Enable address and undefined behavior sanitizers" OFF)

if(QTSCROBBLER_COVERAGE AND QTSCROBBLER_MULL_PLUGIN)
    message(FATAL_ERROR "Use separate coverage and mutation build directories")
endif()
if((QTSCROBBLER_COVERAGE OR QTSCROBBLER_MULL_PLUGIN) AND NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang")
    message(FATAL_ERROR "LLVM coverage and Mull require the qualified Clang toolchain")
endif()
if(QTSCROBBLER_SANITIZERS AND (QTSCROBBLER_COVERAGE OR QTSCROBBLER_MULL_PLUGIN))
    message(FATAL_ERROR "Use a separate sanitizer build directory")
endif()
if(QTSCROBBLER_MULL_PLUGIN AND NOT EXISTS "${QTSCROBBLER_MULL_PLUGIN}")
    message(FATAL_ERROR "Mull compiler plugin does not exist: ${QTSCROBBLER_MULL_PLUGIN}")
endif()

foreach(production_target IN ITEMS scrobble scrobble_gui scrobbler qtscrob)
    if(QTSCROBBLER_COVERAGE OR QTSCROBBLER_MULL_PLUGIN)
        target_compile_options(${production_target} PRIVATE -fprofile-instr-generate)
        if(QTSCROBBLER_COVERAGE)
            target_compile_options(${production_target} PRIVATE -fcoverage-mapping)
        endif()
        target_link_options(${production_target} PRIVATE -fprofile-instr-generate)
    endif()
    # Mull 0.38 misclassifies covered source ranges when mapping is present.
    # Mutation campaigns execute every generated mutant; separate LLVM builds
    # provide trustworthy coverage classification without filtering execution.
    if(QTSCROBBLER_MULL_PLUGIN)
        target_compile_options(${production_target} PRIVATE
            "-fpass-plugin=${QTSCROBBLER_MULL_PLUGIN}" -g -grecord-command-line)
    endif()
    if(QTSCROBBLER_SANITIZERS)
        target_compile_options(${production_target} PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
        target_link_options(${production_target} PRIVATE -fsanitize=address,undefined)
    endif()
endforeach()

# Static production libraries need their instrumentation runtime in every consumer.
if(QTSCROBBLER_COVERAGE OR QTSCROBBLER_MULL_PLUGIN)
    target_compile_options(scrobble INTERFACE -fprofile-instr-generate)
    if(QTSCROBBLER_COVERAGE)
        target_compile_options(scrobble INTERFACE -fcoverage-mapping)
    endif()
    target_link_options(scrobble INTERFACE -fprofile-instr-generate)
endif()
if(QTSCROBBLER_SANITIZERS)
    target_link_options(scrobble INTERFACE -fsanitize=address,undefined)
endif()
