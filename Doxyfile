PROJECT_NAME = QtScrobbler
OUTPUT_DIRECTORY = quality-reports/api
INPUT = src/lib src/cli src/qt/src documents/API.md
RECURSIVE = NO
FILE_PATTERNS = *.h *.cpp *.md
EXTRACT_ALL = YES
EXTRACT_PRIVATE = NO
EXCLUDE_PATTERNS = */moc_* */ui_* */parse-mtp-win32.cpp
GENERATE_HTML = YES
GENERATE_LATEX = NO
QUIET = YES
WARN_AS_ERROR = YES
WARN_IF_UNDOCUMENTED = NO
WARN_IF_DOC_ERROR = YES
HAVE_DOT = NO
USE_MDFILE_AS_MAINPAGE = documents/API.md
ENABLE_PREPROCESSING = YES
MACRO_EXPANSION = YES
PREDEFINED = HAVE_LIBMTP
